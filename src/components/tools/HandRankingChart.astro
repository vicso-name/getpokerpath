---
import { cardName } from '../../lib/poker/cards';
import { HAND_RANKINGS, formatHandShare } from '../../lib/poker/handRankings';
import { CardFace } from '../poker/CardFace';
---

<ol class="chart">
  {
    HAND_RANKINGS.map((ranking, index) => (
      <li class="chart__row">
        <span class="chart__rank" aria-hidden="true">
          {index + 1}
        </span>
        <div class="chart__body">
          <h3>{ranking.name}</h3>
          <div
            class="chart__cards"
            role="img"
            aria-label={`Example: ${ranking.example.map(cardName).join(', ')}`}
          >
            {ranking.example.map((card) => (
              <CardFace card={card} decorative />
            ))}
          </div>
          <p>{ranking.summary}</p>
          <p class="chart__share">
            {ranking.fiveCardCombos.toLocaleString('en-US')} of 2,598,960 five-card hands (
            {formatHandShare(ranking.fiveCardCombos)})
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .chart {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chart__row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .chart__rank {
    color: var(--color-brand);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .chart__body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .chart__cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: 0.56rem;
  }

  .chart__share {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
